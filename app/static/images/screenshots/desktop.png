    <!-- Favicon & icons -->
    <link rel="icon" type="image/png" sizes="32x32" href="http://localhost:5000/static/images/icon-96x96.png">
    <link rel="icon" type="image/png" sizes="192x192" href="http://localhost:5000/static/images/icon-192x192.png">
