# ==========================================
# LionFlow AI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# ==========================================

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-with-a-very-long-random-string-please

# --- Base de données MySQL ---
DATABASE_URL=mysql+pymysql://lionflow_user:password@localhost:3306/lionflow_ai
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lionflow_ai
MYSQL_USER=lionflow_user
MYSQL_PASSWORD=Ndagukunda540M$

# --- JWT ---
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=3600

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=lionflow-verify-token
WHATSAPP_API_VERSION=v20.0
WHATSAPP_DEV_MODE=1
WHATSAPP_APP_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- App ---
APP_NAME=LionFlow AI
APP_BASE_URL=http://localhost:5000
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH_MB=5

# --- Email (reset password) ---
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@lionflow.ai

# --- Scheduler ---
SCHEDULER_ENABLED=1

# --- Chiffrement des tokens (WhatsApp) ---
TOKEN_ENCRYPTION_SALT=lionflow-ai-token-salt-v1